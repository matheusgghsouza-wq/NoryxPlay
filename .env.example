# Token de usuário do sistema do seu Business Manager (permissões: ads_management, ads_read, pages_read_engagement)
META_ACCESS_TOKEN=
# Se alguma conta estiver em outro Business Manager, crie uma variável para o token dela
# e aponte no config.yaml com token_env (ex.: META_TOKEN_CONTA2=...)
# Token do bot criado no @BotFather
TELEGRAM_BOT_TOKEN=
# ID do grupo onde os criativos são enviados (ex.: -1001234567890)
TELEGRAM_CHAT_ID=

# Senha do painel web (python main.py web). Use uma senha forte.
PANEL_PASSWORD=
# Opcional: chave fixa para o login não cair quando o painel reiniciar (qualquer texto longo e aleatório)
PANEL_SECRET=
